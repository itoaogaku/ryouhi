# =============================================================
# 寮費・食費清算管理システム — 環境変数サンプル
# -------------------------------------------------------------
# このファイルを ".env" にコピーして値を設定してください。
#   cp .env.example .env
#
# Vercel にデプロイする場合は、プロジェクトの
# Settings > Environment Variables に同じ値を登録してください。
# =============================================================

# Google Apps Script Web App のデプロイURL
# GAS エディタで「デプロイ > 新しいデプロイ > ウェブアプリ」を作成し、
# 「アクセスできるユーザー: 全員」で発行された /exec で終わるURLを貼り付けます。
# 例: https://script.google.com/macros/s/AKfycb.../exec
VITE_GAS_API_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXX/exec

# （任意）バックエンドを接続せずダミーデータのみで動かす場合は true にします。
# VITE_GAS_API_URL が未設定でも自動的にダミーデータへフォールバックします。
VITE_USE_DUMMY_DATA=false
